# ─────────────────────────────────────────────────────────────────────────────
# MealBalance — Environment Variables
#
# 1. Copy this file:   cp .env.example .env.local
# 2. Fill in real values from your Supabase project
# 3. NEVER commit .env.local to Git
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your project URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your project's anon/public key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── IMPORTANT: Never add these to your .env.local or any public file ──────────
# SUPABASE_SERVICE_ROLE_KEY   ← keep server-side only, never in NEXT_PUBLIC_*
# DATABASE_URL                ← never expose the direct Postgres URL
